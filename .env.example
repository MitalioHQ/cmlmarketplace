# Copied to .env.local for local development. Never expose these values to Vite.
CML_API_KEY=
CML_API_SECRET=
CML_CHANNEL_SLUG=northstar
CML_DEFAULT_COUNTRY=FR
CML_API_BASE_URL=https://vwqretlvkrravzguxydw.functions.eu-west-2.nhost.run/v1

# Required for durable checkout state in production.
DATABASE_URL=

# Checkout creates live CML customers/orders and can record a live payment.
# Keep disabled until the deployment is protected and verified.
CML_DEMO_MUTATIONS_ENABLED=false

# Optional comma-separated additional origins allowed to call mutation routes.
CML_ALLOWED_ORIGINS=
