{
  "name": "@cml-marketplace/demo-store",
  "version": "0.1.0",
  "private": true,
  "description": "Generic marketplace reference storefront for the CML commerce SDK.",
  "type": "module",
  "scripts": {
    "build:dependencies": "npm run build -w @cml-marketplace/core && npm run build -w @cml-marketplace/server",
    "prebuild": "npm run build:dependencies",
    "build": "next build",
    "predev": "npm run build:dependencies",
    "dev": "next dev --hostname 127.0.0.1 --port 4173",
    "start": "next start",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "node scripts/migrate-database.mjs"
  },
  "dependencies": {
    "@cml-marketplace/core": "0.1.0",
    "@cml-marketplace/server": "0.1.0",
    "@next/env": "^16.2.11",
    "next": "^16.2.11",
    "postgres": "^3.4.9",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": "24.x"
  }
}
